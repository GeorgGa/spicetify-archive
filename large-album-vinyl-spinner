@keyframes rotating {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.Root__top-container:has(
    button[data-testid="control-button-playpause"][aria-label="Pause"]
  ) #album-art-face-front,
.Root__top-container:has(
    button[data-testid="control-button-playpause"][aria-label="Play"]
  ) #album-art-face-front {
  animation: rotating 1.8s linear infinite;
  clip-path: circle(50% at 50% 50%);
  position: relative;
}

.Root__top-container:has(
    button[data-testid="control-button-playpause"][aria-label="Pause"]
  ) #album-art-face-front {
  animation-play-state: running;
}

.Root__top-container:has(
    button[data-testid="control-button-playpause"][aria-label="Play"]
  ) #album-art-face-front {
  animation-play-state: paused;
}

#album-art-face-front::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 22%;
  height: 22%;
  background: radial-gradient(
      circle at center,
      rgba(24, 22, 35, 0.9) 0%,
      rgba(24, 22, 35, 0.9) 38%,
      rgba(255, 255, 255, 0.1) 38%,
      rgba(255, 255, 255, 0.1) 40%,
      rgba(24, 22, 35, 0.9) 40%,
      rgba(24, 22, 35, 0.9) 100%
    ),
    repeating-radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.1) 0,
      rgba(255, 255, 255, 0.1) 1px,
      transparent 1px,
      transparent 4px
    );
  border-radius: 50%;
  pointer-events: none;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3) inset,
    0 0 20px rgba(255, 255, 255, 0.1);
  z-index: 2;
}

#album-art-face-front::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6%;
  height: 6%;
  background: rgba(24, 22, 35, 1);
  border-radius: 50%;
  box-shadow: 0 0 5px rgba(255, 255, 255, 0.2);
  z-index: 1;
}

#album-art-flip-inner {
  transform: scale3d(0.33334, 0.33334, 0.33334) !important;
  transition: none !important;
  box-shadow: none !important;
  clip-path: circle(50% at 50% 50%) !important;
}

#album-art-face-back .album-art-env {
  visibility: hidden !important;
  z-index: 2;
}
